/* Theme tokens are resolved by src/ui/resources.py before Qt loads this file.
   Use literal values in :root and var(--token-name) in component rules.
   Qt QSS does not resolve CSS custom properties itself. */
:root {
    /* Text */
    --color-text: #e5e9f0;
    --color-text-muted: #a4b0c0;
    --color-text-subtle: #929cab;
    --color-text-disabled: #788292;
    --color-text-selected: #f1f5fb;
    --color-text-header: #acb9ca;

    /* Backgrounds */
    --bg-window: #191d24;
    --bg-surface: rgba(30, 35, 43, 245);
    --bg-transparent: transparent;
    --bg-button: #303949;
    --bg-button-hover: #3b4960;
    --bg-disabled: #252c37;
    --bg-tool-hover: #394353;
    --bg-tool-pressed: #536277;
    --bg-tool-checked: #2e6655;
    --bg-primary: #315f53;
    --bg-primary-hover: #3c7465;
    --bg-input: #222935;
    --bg-input-selection: #486d94;
    --bg-list: #202630;
    --bg-list-selected: #354c60;
    --bg-list-preview: #2c3542;
    --bg-list-connected: #315f53;
    --bg-list-header: #29313e;
    --bg-menu: #242c37;
    --bg-menu-selected: #3a4b60;

    /* Borders and separators */
    --border-width: 1px;
    --border-surface: #46505f;
    --border-button: #48556b;
    --border-disabled: #333c4a;
    --border-primary: #498875;
    --border-input: #475467;
    --border-focus: #79aa9b;
    --border-list: #394454;
    --border-menu: #4c586a;
    --border-checkbox: #5a677c;
    --color-menu-separator: #435064;

    /* Corners and typography */
    --radius-surface: 9px;
    --radius-control: 5px;
    --radius-tool: 6px;
    --radius-input: 4px;
    --radius-checkbox: 3px;
    --font-family: "Segoe UI", "Malgun Gothic";
    --font-size-body: 12px;
    --font-size-small: 11px;
    --font-size-heading: 19px;
    --font-size-page-title: 15px;
    --font-size-drag-handle: 20px;
    --font-weight-heading: 600;
}

/* Base: application windows and shared text roles */
QWidget {
    font-family: var(--font-family);
    font-size: var(--font-size-body);
    color: var(--color-text);
}
QDialog, QWidget#programsWindow { background: var(--bg-window); }
QLabel#heading { font-size: var(--font-size-heading); font-weight: var(--font-weight-heading); }
QLabel#muted, QLabel#status { color: var(--color-text-muted); }

/* Buttons: standard actions and primary actions */
QPushButton {
    background: var(--bg-button);
    border: var(--border-width) solid var(--border-button);
    border-radius: var(--radius-control);
    padding: 7px 12px;
}
QPushButton:hover { background: var(--bg-button-hover); }
QPushButton:disabled {
    color: var(--color-text-disabled);
    background: var(--bg-disabled);
    border-color: var(--border-disabled);
}
QPushButton#primaryButton { background: var(--bg-primary); border-color: var(--border-primary); }
QPushButton#primaryButton:hover { background: var(--bg-primary-hover); }

/* Inputs: text fields, checkboxes and combo boxes */
QLineEdit {
    background: var(--bg-input);
    border: var(--border-width) solid var(--border-input);
    border-radius: var(--radius-input);
    padding: 7px;
    selection-background-color: var(--bg-input-selection);
}
QLineEdit:focus { border-color: var(--border-focus); }
QLineEdit#compactField { padding: 4px 6px; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: var(--border-width) solid var(--border-checkbox);
    border-radius: var(--radius-checkbox);
    background: var(--bg-input);
}
QCheckBox::indicator:hover { border-color: var(--border-focus); }
QCheckBox::indicator:checked {
    background: var(--bg-primary-hover);
    border-color: var(--border-focus);
    image: url("../icons/check.svg");
}
QComboBox {
    background: var(--bg-input);
    border: var(--border-width) solid var(--border-input);
    border-radius: var(--radius-input);
    padding: 4px 8px;
    min-height: 18px;
}
QComboBox:hover, QComboBox:focus { border-color: var(--border-focus); }
QComboBox QAbstractItemView {
    background: var(--bg-menu);
    border: var(--border-width) solid var(--border-menu);
    selection-background-color: var(--bg-menu-selected);
    outline: none;
}

/* Lists: program lists and shared headers */
QTreeWidget {
    background: var(--bg-list);
    color: var(--color-text);
    border: var(--border-width) solid var(--border-list);
    border-radius: var(--radius-control);
}
QTreeWidget::item { padding: 7px 4px; }
QTreeWidget::item:selected { background: var(--bg-list-selected); color: var(--color-text-selected); }
/* Program lists: one click previews a row; confirmed attachments stay green. */
QTreeWidget#windowList {
    qproperty-connectedBackground: var(--bg-list-connected);
    qproperty-connectedForeground: var(--color-text-selected);
    outline: none;
}
QTreeWidget#windowList::item:selected {
    background: var(--bg-list-preview);
    color: var(--color-text-selected);
}
QHeaderView::section {
    background: var(--bg-list-header);
    padding: 7px;
    border: none;
    color: var(--color-text-header);
}

/* Menus: toolbar and tray menus */
QMenu {
    background: var(--bg-menu);
    border: var(--border-width) solid var(--border-menu);
    padding: 5px;
}
QMenu::item { padding: 8px 20px; border-radius: var(--radius-input); }
QMenu::item:selected { background: var(--bg-menu-selected); }
QMenu::separator { height: 1px; background: var(--color-menu-separator); margin: 4px 8px; }

/* Surfaces: shared toolbar and dialog card appearance */
QFrame#toolbarSurface, QFrame#dialogSurface {
    background: var(--bg-surface);
    border: var(--border-width) solid var(--border-surface);
    border-radius: var(--radius-surface);
}

/* ToolbarWidget / CmmButton / DragHandle */
QLabel#dragHandle { color: var(--color-text-subtle); font-size: var(--font-size-drag-handle); }
QToolButton#toolbarButton { background: var(--bg-transparent); border: none; border-radius: var(--radius-tool); }
QToolButton#toolbarButton:hover { background: var(--bg-tool-hover); }
QToolButton#toolbarButton:checked { background: var(--bg-tool-checked); }
QToolButton#toolbarButton:pressed { background: var(--bg-tool-pressed); }

/* CmmDialogLayout: shared header, title and close button */
QDialog#positionDialog, QDialog#commonDialog, QDialog#SettingDialog { background: var(--bg-transparent); }
QWidget#dialogHeader { background: var(--bg-transparent); }
QLabel#dialogTitle {
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-heading);
    color: var(--color-text);
}
QToolButton#closeButton {
    background: var(--bg-transparent);
    border: none;
    border-radius: var(--radius-control);
    color: var(--color-text-subtle);
    padding: 0;
    font-size: var(--font-size-small);
}
QToolButton#closeButton:hover { background: var(--bg-tool-hover); color: var(--color-text); }
QToolButton#closeButton:pressed { background: var(--bg-tool-pressed); }
QDialog#positionDialog QPushButton, QDialog#commonDialog QPushButton,
QDialog#SettingDialog QPushButton { padding: 4px 14px; }

/* CmmDialog / WdSizeDialog: body text and compact geometry fields */
QLabel#fieldLabel { color: var(--color-text-subtle); font-size: var(--font-size-small); font-weight: var(--font-weight-heading); }
QDialog#positionDialog QLabel#status { font-size: var(--font-size-small); }
QLabel#commonDialogText { color: var(--color-text-muted); font-size: var(--font-size-body); background: var(--bg-transparent); }

/* SettingDialog: navigation tree, page title and divider */
QScrollArea#settingsScroll, QWidget#settingsViewport, QWidget#settingsContent {
    background: var(--bg-transparent);
    border: none;
}
QTreeWidget#settingNav {
    background: var(--bg-list);
    border: var(--border-width) solid var(--border-list);
    border-radius: var(--radius-control);
    outline: none;
}
QTreeWidget#settingNav::item { padding: 6px 4px; }
QTreeWidget#settingNav::branch { background: var(--bg-transparent); }
QTreeWidget#settingNav::branch:selected { background: var(--bg-list-selected); }
QTreeWidget#settingNav::item:hover:!selected { background: var(--bg-list-header); }
QLabel#pageTitle { font-size: var(--font-size-page-title); font-weight: var(--font-weight-heading); }
QFrame#pageLine { background: var(--border-list); border: none; }

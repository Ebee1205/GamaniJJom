{
  "environment": "local",
  "project_name": "GamaniJJom",
  "secret_key": "",
  "logger": {
    "level": "DEBUG",
    "path": "logs/gamani-jjom.log",
    "suffix": "%Y%m%d",
    "max_bytes": 10485760,
    "max_files": "7d",
    "rotation": "midnight",
    "use_console": true
  },
  "save": {
    "path": "D:/saves/",
    "scale": 1,
    "notification_enabled": true,
    "copy_to_clipboard": true,
    "filename": {
      "prefix": "capture_",
      "postfix_date_enabled": true,
      "postfix_date_format": "%Y%m%d_%H%M%S_%f"
    }
  },
  "theme": "circle"
}
